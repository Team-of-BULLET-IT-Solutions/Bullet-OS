cc_binary {
    name: "bulletd",
    srcs: ["bulletd.cpp"],
    init_rc: ["bulletd.rc"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-O3",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libcutils",
    ],
    vendor_available: false,
    system_ext_specific: true,
}
